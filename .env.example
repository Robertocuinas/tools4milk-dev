# Tools4Milk — Demo portable Release 3 (fichero de EJEMPLO, no real)
# =====================================================================
# Cómo usarlo (Windows / Linux / macOS, solo biblioteca estándar):
#
#   python scripts/demo.py init     # genera .env local con secretos aleatorios
#   python scripts/demo.py up       # levanta el stack demo
#   python scripts/demo.py smoke    # verificación reproducible
#   python scripts/demo.py down     # apaga el stack (solo proyecto tfm_r3_demo)
#
# NO copies secretos reales a este fichero ni lo commitees con valores
# reales. Los valores aquí son PLACEHOLDERS inequívocos: la demo no
# arranca con ellos tal cual; `demo.py init` los sustituye por secretos
# aleatorios en el `.env` local (no commiteado, ver .gitignore).
# Las credenciales demo viven SOLO en tu `.env` local. Para consultarlas,
# abre el fichero `.env` en tu editor; no las pegues en logs, issues ni CI.
# En producción: INITIAL_DEMO_PASSWORD debe quedar VACÍA (el backend
# rechaza arrancar si tiene valor) y SECRET_KEY debe ser un secreto
# único de al menos 32 caracteres.

# --- Proyecto Compose aislado (canónico Release 3; no tocar otros) ---
COMPOSE_PROJECT_NAME=tfm_r3_demo

# --- Entorno del backend: development | demo | test | production ---
# La demo usa `development`. `production` activa validaciones duras
# (SECRET_KEY>=32, sin password demo, sin SQLite, APP_URL HTTPS, CORS HTTPS).
ENVIRONMENT=development

# --- Base de datos (servicio `db`, PostgreSQL 15) ---
POSTGRES_USER=postgres
# PLACEHOLDER — `demo.py init` genera una contraseña aleatoria.
POSTGRES_PASSWORD=CAMBIAME-genera-con-demo-py-init-0000
POSTGRES_DB=tools4milk
# URL interna (host `db`, no `localhost`). Se construye con la password
# anterior; el placeholder siguiente se regenera en `init`.
DATABASE_URL=postgresql+psycopg://postgres:CAMBIAME@db:5432/tools4milk

# --- Seguridad backend ---
# PLACEHOLDER — `demo.py init` genera un valor aleatorio (token_urlsafe).
# Mínimo 32 caracteres en producción; si cambia, los tokens emitidos caducan.
SECRET_KEY=CAMBIAME-genera-con-demo-py-init-minimo-32-caracteres-0000
# TTL del access token en minutos. Canónico Release 3: 480 (8 h),
# alineado con la cookie HttpOnly `t4m_token` de `backend/app/security.py`.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Refresh token (cookie HttpOnly `t4m_refresh`, SameSite=Strict).
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_MAX_PER_USER=5

# --- Usuarios demo (SOLO development/demo/test; VACÍO en producción) ---
# PLACEHOLDER — `demo.py init` genera una contraseña aleatoria local.
# El backend crea 5 usuarios (admin, roberto.castro, operario.zona,
# laura.fernandez, dr.mendez) solo si este valor NO está vacío.
INITIAL_DEMO_PASSWORD=CAMBIAME-genera-con-demo-py-init-0000

# --- URLs y CORS (demo local) ---
APP_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost","http://localhost:80","http://127.0.0.1","http://localhost:3000","http://127.0.0.1:3000"]

# --- AEMET OpenData (OPCIONAL; sin ella la demo usa datos sintéticos) ---
AEMET_API_KEY=
AEMET_MUNICIPIO_ID=27065
AEMET_ESTACION_ID=

# --- Scheduler sintético (servicio `scheduler`, sin Redis/Celery) ---
SYNTHETIC_INTERVAL_SECONDS=3600
SYNTHETIC_PROFILE=small
SYNTHETIC_SCENARIO=normal
SYNTHETIC_SEED=20260602
